PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_PATH=./data/crafthost.db
DOCKER_SOCKET=/var/run/docker.sock
SERVER_PORT_START=25565
SERVER_PORT_END=26564
DATA_DIR=./data/servers
BACKUP_DIR=./backups
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
MODRINTH_API=https://api.modrinth.com/v2
PAPER_API=https://api.papermc.io/v2
MOJANG_MANIFEST=https://launchermeta.mojang.com/mc/game/version_manifest.json

# Java for Minecraft servers (needs 21+ for MC 1.20.5+, 25 for 1.21.6+).
# Falls back to JAVA_HOME, then "java" on PATH.
# MC_JAVA_HOME=/opt/jdk

# Force the server controller: docker | jvm | stub (default: docker if reachable, else jvm)
# CONTROLLER_BACKEND=jvm
